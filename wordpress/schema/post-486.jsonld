      "mainEntity": [
        {
          "@type": "Question",
          "name": "أين يقع مركز الدفة في حي السامر بجدة؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "يقع على شارع وهيب بن عمير في حي السامر بجدة بجوار بنك البلاد مباشرة، ورقم الواتساب الرسمي للفرع 0561560303 وحسابه @aldaffahsa1."
          }
        },
        {
          "@type": "Question",
          "name": "ما الفرق بين مركز الدفة حي السامر ومركز الدفة سوق المرجان؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "فرع الدفة السامر يقع على شارع وهيب بن عمير بجوار بنك البلاد (0561560303 / @aldaffahsa1)، بينما فرع الدفة المرجان يقع بحي الصفا داخل سوق المرجان بوابة 2 محل 205 (0558977126 / @aldaffahsa)، ولكل منهما مخزون مستقل."
          }
        },
        {
          "@type": "Question",
          "name": "هل تتوفر أحذية شرقية (شراقي) وثياب ولادية في فرع الدفة السامر؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "نعم، تتوفر تشكيلات الثياب الرجالية والولادية والأحذية الشرقية والملابس الداخلية، ويُنصح بتأكيد المقاس عبر واتساب الفرع قبل الزيارة."
          }
        }
      ]
